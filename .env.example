# Copy to .env (or set in your process manager) to configure the service.

# TCP port the HTTP server listens on.
PORT=4180

# Printer character device. The default suits a USB Epson printer on Linux.
PRINTER_DEVICE=/dev/usb/lp0

# Set to 1 to render to stdout instead of a device (no printer needed).
DRY_RUN=0

# Blank feed lines added below every receipt before the cut.
BOTTOM_PADDING_LINES=4

# Max accepted body size for a single print request.
MAX_BODY_SIZE=64kb

# pino log level: trace | debug | info | warn | error | fatal
LOG_LEVEL=info
